# Database
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/clodsapp
SUPABASE_DATABASE_URL=

# Alien.org Auth (placeholders)
ALIEN_AUTH_ISSUER=https://alien.org
ALIEN_AUTH_CLIENT_ID=your_client_id
ALIEN_AUTH_CLIENT_SECRET=your_client_secret
ALIEN_AUTH_AUTHORIZE_URL=https://alien.org/oauth/authorize
ALIEN_AUTH_TOKEN_URL=https://alien.org/oauth/token
ALIEN_AUTH_JWKS_URL=https://alien.org/.well-known/jwks.json
ALIEN_AUTH_REDIRECT_URI=http://localhost:5000/api/auth/alien/callback

# OpenClaw (placeholders)
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=

# WhatsApp Cloud API (placeholders)
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
